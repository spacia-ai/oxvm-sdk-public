  "recorder": "# Recorder for the RFC 7919 groups, which Node 24 does not expose: OpenSSL's own tables, read through the CLI.\n#   docker run --rm -v \"$PWD\":/w:ro node:24.18.1-alpine sh /w/record-ffdhe.sh\nset -e\napk add --no-cache openssl >/dev/null 2>&1\nopenssl version\nfor g in ffdhe2048 ffdhe3072 ffdhe4096 ffdhe6144 ffdhe8192 modp_1536 modp_2048; do\n  echo \"GROUP $g\"\n  openssl genpkey -algorithm DH -pkeyopt group:$g 2>/dev/null | openssl pkey -pubout -outform DER | openssl asn1parse -inform DER | grep INTEGER | head -3 | sed 's/.*INTEGER *://'\ndone\n",
