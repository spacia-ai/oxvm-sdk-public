 "recorder": "// Recorder for node-crypto-dh-groups.controls.json. Run with:\n//   docker run --rm -v \"$PWD\":/w:ro node:24.18.1-alpine node /w/record-dh.cjs > node-crypto-dh-groups.controls.json\nconst crypto = require('node:crypto');\nconst fs = require('node:fs');\nconst failure = f => { try { return f(); } catch (e) { return { name: e.name, message: e.message, code: e.code }; } };\nconst tlv = (buf, at) => { let len = buf[at + 1]; let head = 2; if (len & 0x80) { const n = len & 0x7f; len = 0; for (let i = 0; i < n; i++) len = len * 256 + buf[at + 2 + i]; head = 2 + n; } return { tag: buf[at], start: at + head, end: at + head + len }; };\nconst children = (buf, node) => { const out = []; let at = node.start; while (at < node.end) { const child = tlv(buf, at); out.push(child); at = child.end; } return out; };\nconst integer = (buf, node) => buf.subarray(node.start, node.end).toString('hex').replace(/^(00)+(?=.)/u, '');\nconst modp = {};\nfor (const name of ['modp1', 'modp2', 'modp5', 'modp14', 'modp15', 'modp16', 'modp17', 'modp18']) {\n  const group = crypto.getDiffieHellman(name);\n  modp[name] = { prime: group.getPrime('hex'), generator: group.getGenerator('hex'), verifyError: group.verifyError, sameFromCreate: crypto.createDiffieHellmanGroup(name).getPrime('hex') === group.getPrime('hex') };\n}\n// Node 24 knows no RFC 7919 group: neither getDiffieHellman nor generateKeyPairSync('dh', { group }) takes one.\nconst ffdhe = {};\nfor (const name of ['ffdhe2048', 'ffdhe3072', 'ffdhe4096', 'ffdhe6144', 'ffdhe8192']) ffdhe[name] = { getDiffieHellman: failure(() => crypto.getDiffieHellman(name).getPrime('hex').length), keyPair: failure(() => typeof crypto.generateKeyPairSync('dh', { group: name })) };\nconst others = {};\nfor (const name of ['modp1', 'modp14', 'modp18']) {\n  const pair = crypto.generateKeyPairSync('dh', { group: name });\n  const der = pair.publicKey.export({ type: 'spki', format: 'der' });\n  const parameters = children(der, children(der, children(der, tlv(der, 0))[0])[1]);\n  others[name] = { primeMatches: integer(der, parameters[0]) === modp[name].prime, generator: integer(der, parameters[1]), parameterCount: parameters.length, extraBits: parameters.slice(2).map(node => integer(der, node)) };\n}\nconst unknown = { getDiffieHellman: failure(() => crypto.getDiffieHellman('modp3')), keyPair: failure(() => crypto.generateKeyPairSync('dh', { group: 'modp3' })), upperCase: failure(() => crypto.getDiffieHellman('MODP14').getPrime('hex').length) };\nprocess.stdout.write(JSON.stringify({ node: { version: process.version, openssl: process.versions.openssl }, recorder: fs.readFileSync(__filename, 'utf8'), modp, ffdhe, keyPairGroups: others, unknown }, null, 1) + '\\n');\n",
